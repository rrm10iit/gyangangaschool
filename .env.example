# Copy this file to ".env" and fill in the values. Never commit ".env".

# ---- Database ----
DB_PASSWORD=change-me-to-a-long-random-password

# ---- Security ----
# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# ---- First admin account (created on first start only) ----
ADMIN_EMAIL=admin@gyanganga.school
# If left empty, a one-time password is printed in the backend log:  docker compose logs backend
ADMIN_PASSWORD=

# ---- Website address ----
# Local testing over plain HTTP:
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
COOKIE_SECURE=false
# Production with HTTPS (replace with your domain; DNS must point to this server):
#   SITE_ADDRESS=www.example.com
#   PUBLIC_URL=https://www.example.com
#   COOKIE_SECURE=true

# Host ports (change HTTP_PORT if port 80 is already used on this machine)
HTTP_PORT=80
HTTPS_PORT=443

# ---- Sample data ----
# true  = fills the site with sample students, teachers, fees and photos so you can try everything.
# false = starts with only the school content (use this for the real launch).
SEED_DEMO_DATA=true

# ---- Email (Brevo) ----
# Create an API key in Brevo (SMTP & API > API keys) and verify the sender address there.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Gyan Ganga School
# Where admission enquiries are sent. Defaults to the school email in Admin > Page content.
ENQUIRY_NOTIFY_EMAIL=
