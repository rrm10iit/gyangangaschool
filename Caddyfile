{
	servers {
		# Traffic that arrives through the Cloudflare tunnel comes from a private Docker address.
		# Trust it, and use the visitor address Cloudflare reports, so rate limits and the
		# activity log see each visitor instead of one shared tunnel address.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Reverse proxy with automatic HTTPS.
# SITE_ADDRESS=:80 serves plain HTTP (local testing).
# SITE_ADDRESS=school.example.com gets a free Let's Encrypt certificate automatically.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API and uploaded files go straight to the Java backend.
	@backend path /api/* /uploads/*
	handle @backend {
		request_body {
			max_size 60MB
		}
		reverse_proxy backend:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Everything else is the Next.js website.
	handle {
		reverse_proxy frontend:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}
